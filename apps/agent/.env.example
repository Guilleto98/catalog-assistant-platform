# Create this credential in the OpenAI Platform. Never commit apps/agent/.env.
OPENAI_API_KEY=

# ADK Python uses LiteLLM provider/model notation for OpenAI.
AGENT_MODEL=openai/gpt-6-luna
CATALOG_API_BASE_URL=http://localhost:3000/api/v1
CATALOG_API_TIMEOUT_SECONDS=10

# Stage 5A intake. Paths are relative to apps/agent when omitted.
ATTACHMENT_STORAGE_PATH=var/attachments
INTAKE_DATABASE_PATH=var/intake.db
ATTACHMENT_MAX_SIZE_BYTES=26214400
ATTACHMENT_ALLOWED_EXTENSIONS=.webm,.mp3,.mp4,.m4a,.wav,.pdf,.xlsx
ATTACHMENT_ALLOWED_MIME_TYPES=audio/webm,audio/mpeg,audio/mp4,audio/wav,application/pdf,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
SPREADSHEET_MAX_CELLS=10000
PDF_MAX_CHARACTERS=200000
TRANSCRIPTION_MODEL=gpt-transcribe
DOCUMENT_EXTRACTION_MODEL=gpt-6-luna

# Semantic domain guard. Uses the same OpenAI provider with a smaller model.
DOMAIN_SCOPE_ENABLED=true
DOMAIN_SCOPE_MODEL=gpt-4.1-mini
DOMAIN_SCOPE_TIMEOUT_SECONDS=8

# Stage 6A product platform. Session lifetime is in seconds.
APPLICATION_DATABASE_PATH=var/application.db
ADK_DATABASE_PATH=var/adk_sessions.db
AUTH_SESSION_TTL=28800
AUTH_COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:4200
# Enable only for internal legacy intake tests, never for the product frontend.
LEGACY_INTAKE_ENABLED=false
