                {
                  "type": "boolean"
                },
                {
                  "type": "string",
                  "nullable": true
                }
              ]
            }
          },
          "codigos_asociaciones": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "string",
                  "nullable": true
                }
              ]
            }
          },
          "envase_pesaje": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string"
