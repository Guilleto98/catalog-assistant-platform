  "info": {
    "title": "Uruguay Meat Catalog API",
    "description": "API educativa: datos 100 % sintéticos, no oficiales",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "demo-user": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Demo-User-Id",
        "description": "Simulación local; no autentica"
      }
    },
    "schemas": {
      "FilterDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "example": "producto_destino.mercado"
          },
          "operator": {
            "type": "string",
            "enum": [
              "eq",
              "neq",
              "in",
              "contains",
              "gte",
              "lte",
              "between",
              "is_null"
            ]
          },
          "value": {
            "type": "object",
            "example": "CHINA",
            "description": "Omitir para is_null; array para in/between"
          }
        },
        "required": [
          "field",
          "operator"
        ]
      },
      "SortDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "example": "identificacion.codigo"
          },
          "direction": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          }
        },
        "required": [
          "field",
          "direction"
        ]
      },
      "SearchArticlesDto": {
        "type": "object",
        "properties": {
          "filters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FilterDto"
            }
          },
          "sort": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SortDto"
            }
          },
          "page": {
            "type": "object",
            "default": 1,
            "minimum": 1
          },
          "page_size": {
            "type": "object",
            "default": 20,
            "minimum": 1,
            "maximum": 50
          }
        }
      },
      "ArticleSummaryResponseDto": {
        "type": "object",
        "properties": {
          "codigo": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "corte": {
            "type": "string"
          },
          "especie": {
            "type": "string"
          },
          "mercado": {
            "type": "string"
          },
          "pais_destino": {
            "type": "string"
          },
          "temperatura": {
            "type": "string"
          },
          "presentacion": {
            "type": "string"
          },
          "envase_primario": {
            "type": "string"
          },
          "envase_exterior": {
            "type": "object",
            "nullable": true
          },
          "tipo_peso": {
            "type": "string"
          },
          "peso_promedio_kg": {
            "type": "number",
            "nullable": true
          },
          "activo": {
            "type": "boolean"
          },
          "ficha_id": {
            "type": "object"
          }
        },
        "required": [
          "codigo",
          "nombre",
          "corte",
          "especie",
          "mercado",
          "pais_destino",
          "temperatura",
          "presentacion",
          "envase_primario",
          "envase_exterior",
          "tipo_peso",
          "peso_promedio_kg",
          "activo"
        ]
      },
      "PaginationResponseDto": {
        "type": "object",
        "properties": {
          "page": {
            "type": "number"
          },
          "page_size": {
            "type": "number"
          },
          "total_items": {
            "type": "number"
          },
          "total_pages": {
            "type": "number"
          }
        },
        "required": [
          "page",
          "page_size",
          "total_items",
          "total_pages"
        ]
      },
      "AppliedFilterResponseDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "operator": {
            "type": "string",
            "enum": [
              "eq",
              "neq",
              "in",
              "contains",
              "gte",
              "lte",
              "between",
              "is_null"
            ]
          },
          "value": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "nullable": true
              },
              {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "string",
                      "nullable": true
                    }
                  ]
                }
              }
            ]
          }
        },
        "required": [
          "field",
          "operator"
        ]
      },
      "AppliedSortResponseDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "direction": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          }
        },
        "required": [
          "field",
          "direction"
        ]
      },
      "SearchArticlesResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ArticleSummaryResponseDto"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/PaginationResponseDto"
          },
          "applied_filters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AppliedFilterResponseDto"
            }
          },
          "applied_sort": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AppliedSortResponseDto"
            }
          }
        },
        "required": [
          "items",
          "pagination",
          "applied_filters",
          "applied_sort"
        ]
      },
      "CompareArticlesDto": {
        "type": "object",
        "properties": {
          "codes": {
            "example": [
              "900001",
              "900002",
              "900003"
            ],
            "minItems": 2,
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "codes"
        ]
      },
      "ArticleComparisonFieldDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "values": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "string",
                  "nullable": true
                }
              ]
            }
          },
          "different": {
            "type": "boolean"
          }
        },
        "required": [
          "field",
          "values",
          "different"
        ]
      },
      "CompareArticlesResponseDto": {
        "type": "object",
        "properties": {
          "compared_codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ArticleComparisonFieldDto"
