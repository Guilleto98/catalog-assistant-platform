          },
          "different_fields_count": {
            "type": "number"
          },
          "equal_fields_count": {
            "type": "number"
          }
        },
        "required": [
          "compared_codes",
          "fields",
          "different_fields_count",
          "equal_fields_count"
        ]
      },
      "ArticleDocumentResponseDto": {
        "type": "object",
        "properties": {
          "identificacion": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
