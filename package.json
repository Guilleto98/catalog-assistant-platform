{
  "name": "solvo-client-catalog-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo de un asistente de catálogo desarrollado por Solvo para un cliente",
  "scripts": {
    "web:install": "npm ci --prefix apps/web",
    "web:dev": "npm run start --prefix apps/web -- --host localhost --port 4200",
    "web:build": "npm run build --prefix apps/web",
    "web:test": "npm run test --prefix apps/web -- --watch=false",
    "web:contracts": "node apps/web/scripts/generate-contracts.mjs",
    "web:lint": "npm run lint --prefix apps/web",
    "web:smoke": "uv run --directory apps/agent python -m scripts.run_web_smoke",
    "api:docker:refresh": "docker compose -f apps/catalog-api/docker-compose.yml -f apps/catalog-api/docker-compose.preserve.yml up -d --build",
    "api:install": "npm install --prefix apps/catalog-api",
    "api:dev": "npm run start:dev --prefix apps/catalog-api",
    "api:start": "npm run start --prefix apps/catalog-api",
    "api:build": "npm run build --prefix apps/catalog-api",
    "api:lint": "npm run lint --prefix apps/catalog-api",
    "api:test": "npm run test --prefix apps/catalog-api",
    "api:test:e2e": "npm run test:e2e --prefix apps/catalog-api",
    "api:db:generate": "npm run db:generate --prefix apps/catalog-api",
    "api:db:reset": "npm run db:reset --prefix apps/catalog-api",
    "api:docs:openapi": "npm run docs:openapi --prefix apps/catalog-api",
    "api:docker:up": "docker compose -f apps/catalog-api/docker-compose.yml up --build",
    "api:docker:down": "docker compose -f apps/catalog-api/docker-compose.yml down",
    "agent:install": "uv sync --project apps/agent",
    "agent:dev": "uv run --directory apps/agent adk web .",
    "agent:run": "uv run --directory apps/agent adk run solvo_client_agent",
    "agent:intake": "uv run --directory apps/agent uvicorn solvo_client_agent.api.app:app --reload --port 3100",
    "agent:api": "uv run --directory apps/agent uvicorn solvo_client_agent.api.app:app --reload --port 3100",
    "agent:bootstrap": "uv run --directory apps/agent python -m solvo_client_agent.platform.cli",
    "agent:demo:login": "uv run --directory apps/agent python -m scripts.create_local_login",
    "agent:platform:smoke": "uv run --directory apps/agent python -m scripts.run_platform_smoke",
    "agent:contracts:export": "uv run --directory apps/agent python -m scripts.export_contracts",
    "agent:test": "uv run --directory apps/agent pytest -m 'not integration and not smoke'",
    "agent:test:integration": "RUN_CATALOG_INTEGRATION=1 uv run --directory apps/agent pytest -m integration",
    "agent:smoke": "uv run --directory apps/agent python -m scripts.run_smoke",
    "agent:intake:smoke": "uv run --directory apps/agent python -m scripts.run_intake_smoke",
    "agent:scope:smoke": "uv run --directory apps/agent python -m scripts.run_scope_smoke"
  }
}
